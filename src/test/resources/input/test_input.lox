fun add(a, b) {
    return a + b;
}

print add(2, 3);

fun sayHi() {
    print "hello from function";
}

sayHi();

fun noReturn() {
    print "no return";
}

print noReturn();

fun earlyReturn() {
    return "returned early";
    print "should not print";
}

print earlyReturn();

fun makeCounter() {
    var count = 0;

    fun countUp() {
        count = count + 1;
        return count;
    }

    return countUp;
}

var counter = makeCounter();
print counter();
print counter();

fun fib(n) {
    if (n <= 1) return n;
    return fib(n - 2) + fib(n - 1);
}

print fib(6);

var scope = "global";

{
    fun showScope() {
        print scope;
    }

    showScope();
    var scope = "block";
    showScope();
}

class Breakfast {
    init(meat, bread) {
        this.meat = meat;
        this.bread = bread;
    }

    serve() {
        return this.meat + " and " + this.bread;
    }
}

var breakfast = Breakfast("bacon", "toast");

print breakfast;
print breakfast.meat;
print breakfast.bread;
print breakfast.serve();

breakfast.meat = "sausage";
print breakfast.meat;

var serveBreakfast = breakfast.serve;
print serveBreakfast();